# Copy to .env to override the defaults compose already applies:
#
#   cp .env.example .env
#
# This file is optional. `docker compose up` works without it.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=mise
POSTGRES_PASSWORD=mise
POSTGRES_DB=mise

# Host port PostgreSQL is published on. Change it if something already owns
# this port. The app container is unaffected either way.
POSTGRES_HOST_PORT=5435

# Used only by tooling you run on the host (prisma migrate dev, prisma studio).
# The app container gets its own DATABASE_URL pointing at the "db" service.
DATABASE_URL=postgresql://mise:mise@localhost:5435/mise

# --- Application ------------------------------------------------------------
APP_PORT=3000
APP_URL=http://localhost:3000

# Signs session cookies. Generate your own before this runs anywhere but your
# own machine:  openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-replace-this-before-deploying

# --- Seed data --------------------------------------------------------------
# Set to false once you have data you care about; the seed is idempotent but
# there is no reason to run it on every start.
SEED_ON_START=true

# The first administrator, created by the seed.
ADMIN_EMAIL=admin@mise.local
ADMIN_PASSWORD=mise-admin-password
ADMIN_NAME=Site Admin

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication
//
// These four models belong to better-auth. Their fields match what
// `getAuthTables` resolves for the configuration in src/lib/auth.ts (email and
// password plus the admin plugin); change them only alongside that config.
// better-auth addresses the tables by their lowercase singular names, hence
// the @@map on each.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?

  sessions Session[]
  accounts Account[]
  recipes  Recipe[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Recipes
// ---------------------------------------------------------------------------

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

model Recipe {
  id          String       @id @default(cuid())
  // Derived from the title plus a random suffix when the recipe is created and
  // never changed afterwards, so links keep working when a title is edited.
  slug        String       @unique
  title       String
  description String?
  servings    Int?
  prepMinutes Int?
  cookMinutes Int?
  sourceName  String?
  sourceUrl   String?
  // Storage key of the uploaded photo, for example "recipes/<uuid>.webp".
  imageKey    String?
  status      RecipeStatus @default(DRAFT)
  // Set when the recipe is first published, cleared when it goes back to draft.
  publishedAt DateTime?
  authorId    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  steps       Step[]
  tags        RecipeTag[]

  @@index([authorId])
  @@index([status, publishedAt])
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  // Zero-based display order.
  position Int
  quantity String?
  unit     String?
  name     String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, position])
}

model Step {
  id       String @id @default(cuid())
  recipeId String
  // Zero-based display order.
  position Int
  text     String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId, position])
}

model Tag {
  id   String @id @default(cuid())
  // Lowercase and trimmed.
  name String @unique

  recipes RecipeTag[]
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
}
